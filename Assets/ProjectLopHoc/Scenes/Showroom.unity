  metallic: 0.9
  smoothness: 0.65
  margin: 0.03
  gap: 0.012
  textRegionStart: 0
  textRegionWidth: 0.75
  titleText: "T\xE0u \u0111i\u1EC7n ng\u1EA7m Sydney Metro "
  titleFont: {fileID: 0}
  titleSizeCm: 4
  titleColor: {r: 0.85, g: 0.2, b: 0.25, a: 1}
  titleStyle: 1
  titleAlignment: 257
  subtitleText: (Alstom Metropolis TS Set)
  subtitleFont: {fileID: 0}
  subtitleSizeCm: 2.2
  subtitleColor: {r: 0.4, g: 0.4, b: 0.4, a: 1}
  subtitleStyle: 2
  subtitleAlignment: 257
  bodyText: "Lo\u1EA1i ph\u01B0\u01A1ng ti\u1EC7n: T\xE0u \u0111i\u1EC7n ng\u1EA7m
    \u0111\xF4 th\u1ECB t\u1EF1 h\xE0nh ho\xE0n to\xE0n (Driverless Metro)\r\nC\u1EA5p
    \u0111\u1ED9 t\u1EF1 \u0111\u1ED9ng h\xF3a: GoA4 (V\u1EADn h\xE0nh kh\xF4ng ng\u01B0\u1EDDi
    l\xE1i qua h\u1EC7 th\u1ED1ng t\xEDn hi\u1EC7u CBTC Urbalis 400)\r\nNh\xE0 s\u1EA3n
    xu\u1EA5t: Alstom\r\nH\u1EC7 th\u1ED1ng v\u1EADn h\xE0nh: M\u1EA1ng l\u01B0\u1EDBi
    Sydney Metro (Bang New South Wales, \xDAc)\r\nC\u1EA5u h\xECnh \u0111o\xE0n t\xE0u:
    6 toa ti\xEAu chu\u1EA9n (th\xF4ng su\u1ED1t to\xE0n b\u1ED9 th\xE2n t\xE0u,
    c\xF3 th\u1EC3 n\u1ED1i d\xE0i l\xEAn 8 toa)\r\nChi\u1EC1u d\xE0i to\xE0n \u0111o\xE0n:
    132 m (kho\u1EA3ng 22 m m\u1ED7i toa)\r\nChi\u1EC1u r\u1ED9ng th\xE2n v\u1ECF:
    2.85 m\r\nChi\u1EC1u cao th\xE2n xe: 3.75 m\r\nKh\u1ED5 \u0111\u01B0\u1EDDng
    ray: 1435 mm (Kh\u1ED5 ti\xEAu chu\u1EA9n qu\u1ED1c t\u1EBF)\r\nV\u1EADn t\u1ED1c
    thi\u1EBFt k\u1EBF: 100 km/h\r\nV\u1EADn t\u1ED1c khai th\xE1c th\u01B0\u01A1ng
    m\u1EA1i: 80 km/h\r\nNgu\u1ED3n \u0111i\u1EC7n c\u1EA5p: 1500V DC qua l\u01B0\u1EDBi
    \u0111i\u1EC7n tr\xEAn cao (Overhead Catenary)\r\nS\u1EE9c ch\u1EE9a thi\u1EBFt
    k\u1EBF: 1100 h\xE0nh kh\xE1ch (378 ch\u1ED7 ng\u1ED3i)\r\nTrang b\u1ECB ti\u1EC7n
    \xEDch: 3 c\u1EEDa \u0111\xF4i m\u1ED7i b\xEAn th\xE2n toa gi\xFAp sinh vi\xEAn
    v\xE0 h\xE0nh kh\xE1ch l\xEAn xu\u1ED1ng nhanh, s\xE0n ph\u1EB3ng ho\xE0n to\xE0n
    kh\xF4ng b\u1EADc th\u1EC1m, khu v\u1EF1c d\xE0nh ri\xEAng cho xe l\u0103n v\xE0
    xe \u0111\u1EA1p"
  bodyFont: {fileID: 0}
  bodySizeCm: 1.8
  bodyColor: {r: 0.15, g: 0.15, b: 0.15, a: 1}
  bodyStyle: 0
  bodyAlignment: 264
