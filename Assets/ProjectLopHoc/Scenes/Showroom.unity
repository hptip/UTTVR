  m_Script: {fileID: 11500000, guid: 3892d434a6106d04ca930ab21d146b76, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TrainInteractable
  objectName: TauMini
  highlightRenderer: {fileID: 0}
  targetSceneName: 
  trainName: "T\xE0u \u0111i\u1EC7n ng\u1EA7m Riyadh Metro (Alstom Metropolis / Siemens
    Inspiro)"
  trainSpecifications: "Lo\u1EA1i ph\u01B0\u01A1ng ti\u1EC7n: T\xE0u \u0111i\u1EC7n
    ng\u1EA7m \u0111\xF4 th\u1ECB t\u1EF1 h\xE0nh ho\xE0n to\xE0n (Driverless Metro)\r\nC\u1EA5p
    \u0111\u1ED9 t\u1EF1 \u0111\u1ED9ng h\xF3a: GoA4 (V\u1EADn h\xE0nh kh\xF4ng ng\u01B0\u1EDDi
    l\xE1i qua h\u1EC7 th\u1ED1ng CBTC)\r\nNh\xE0 s\u1EA3n xu\u1EA5t: Li\xEAn danh
    Alstom / Siemens Mobility\r\nH\u1EC7 th\u1ED1ng v\u1EADn h\xE0nh: M\u1EA1ng l\u01B0\u1EDBi
    Riyadh Metro (Th\u1EE7 \u0111\xF4 Riyadh, \u1EA2 R\u1EADp X\xEA \xDAt)\r\nC\u1EA5u
    h\xECnh \u0111o\xE0n t\xE0u: 2 toa ti\xEAu chu\u1EA9n (kh\u1EDBp n\u1ED1i th\xF4ng
    su\u1ED1t)\r\nChi\u1EC1u d\xE0i \u0111o\xE0n t\xE0u: 36.0 m\r\nChi\u1EC1u r\u1ED9ng
    th\xE2n v\u1ECF: 2.85 m\r\nChi\u1EC1u cao th\xE2n xe: 3.8 m\r\nKh\u1ED5 \u0111\u01B0\u1EDDng
    ray: 1435 mm (Kh\u1ED5 ti\xEAu chu\u1EA9n qu\u1ED1c t\u1EBF)\r\nV\u1EADn t\u1ED1c
    thi\u1EBFt k\u1EBF: 90 km/h (V\u1EADn t\u1ED1c khai th\xE1c th\u01B0\u01A1ng
    m\u1EA1i 80 km/h)\r\nNgu\u1ED3n \u0111i\u1EC7n c\u1EA5p: 750V DC qua h\u1EC7
    th\u1ED1ng ray th\u1EE9 ba (Third Rail)\r\nS\u1EE9c ch\u1EE9a thi\u1EBFt k\u1EBF:
    250 h\xE0nh kh\xE1ch (bao g\u1ED3m 60 ch\u1ED7 ng\u1ED3i b\u1ECDc da)\r\nPh\xE2n
    h\u1EA1ng khoang xe: Khoang H\u1EA1ng Nh\u1EA5t (First Class), Khoang Gia \u0110\xECnh
    v\xE0 Khoang \u0110\u01A1n\r\nH\u1EC7 th\u1ED1ng \u0111i\u1EC1u h\xF2a \u0111\u1EB7c
    th\xF9: C\u1EE5m l\xE0m l\u1EA1nh k\xE9p c\xF4ng su\u1EA5t l\u1EDBn ch\u1ECBu
    nhi\u1EC7t sa m\u1EA1c 55\xB0C, t\xEDch h\u1EE3p m\xE0ng l\u1ECDc ng\u0103n b\u1EE5i
    c\xE1t m\u1ECBn sa m\u1EA1c x\xE2m nh\u1EADp \u0111\u1ED9ng c\u01A1"
