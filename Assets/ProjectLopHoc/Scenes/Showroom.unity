  margin: 0.03
  gap: 0.012
  textRegionStart: 0
  textRegionWidth: 0.75
  titleText: "T\xE0u \u0111i\u1EC7n m\u1EB7t \u0111\u1EA5t G:link "
  titleFont: {fileID: 0}
  titleSizeCm: 4
  titleColor: {r: 0.85, g: 0.2, b: 0.25, a: 1}
  titleStyle: 1
  titleAlignment: 257
  subtitleText: (Bombardier Flexity 2)
  subtitleFont: {fileID: 0}
  subtitleSizeCm: 2.2
  subtitleColor: {r: 0.4, g: 0.4, b: 0.4, a: 1}
  subtitleStyle: 2
  subtitleAlignment: 257
  bodyText: "Lo\u1EA1i ph\u01B0\u01A1ng ti\u1EC7n: T\xE0u \u0111i\u1EC7n nh\u1EB9
    \u0111\xF4 th\u1ECB (LRV)\r\nNh\xE0 s\u1EA3n xu\u1EA5t: Bombardier Transportation
    (Alstom)\r\nH\u1EC7 th\u1ED1ng v\u1EADn h\xE0nh: G:link (Gold Coast, bang Queensland,
    \xDAc)\r\nC\u1EA5u h\xECnh toa: Kh\u1EDBp n\u1ED1i 7 module (100% s\xE0n th\u1EA5p)\r\nChi\u1EC1u
    d\xE0i to\xE0n \u0111o\xE0n: 43.5 m\r\nChi\u1EC1u r\u1ED9ng th\xE2n v\u1ECF:
    2.65 m\r\nChi\u1EC1u cao th\xE2n xe: 3.6 m\r\nKh\u1ED5 \u0111\u01B0\u1EDDng ray:
    1435 mm (Kh\u1ED5 ti\xEAu chu\u1EA9n)\r\nS\u1EE9c ch\u1EE9a thi\u1EBFt k\u1EBF:
    309 h\xE0nh kh\xE1ch (80 ch\u1ED7 ng\u1ED3i)\r\nV\u1EADn t\u1ED1c t\u1ED1i \u0111a:
    70 km/h\r\nNgu\u1ED3n \u0111i\u1EC7n c\u1EA5p: 750V DC qua l\u01B0\u1EDBi \u0111i\u1EC7n
    tr\xEAn cao (Catenary)\r\nTrang b\u1ECB ti\u1EC7n \xEDch: Gi\xE1 g\u1EAFn v\xE1n
    l\u01B0\u1EDBt s\xF3ng \u0111\u1EB7c th\xF9, v\u1ECB tr\xED xe l\u0103n ti\u1EBFp
    c\u1EADn nhanh, \u0111i\u1EC1u h\xF2a k\xE9p c\xF4ng su\u1EA5t l\u1EDBn"
  bodyFont: {fileID: 0}
  bodySizeCm: 1.8
  bodyColor: {r: 0.15, g: 0.15, b: 0.15, a: 1}
  bodyStyle: 0
  bodyAlignment: 264
