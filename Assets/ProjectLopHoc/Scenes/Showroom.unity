MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1814087143}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b2a06afb42866ff43b95b415bab96d02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MuseumLabelStand
  panelWidth: 1.2
  panelHeight: 0.4
  panelThickness: 0.02
  tiltAngle: 20
  frameBorder: 0.01
  frameColor: {r: 0.92, g: 0.92, b: 0.92, a: 1}
  faceColor: {r: 1, g: 1, b: 1, a: 1}
  poleHeight: 0.9
  poleSpacing: 0.8
  poleDiameter: 0.03
  baseDiameter: 0.3
  baseThickness: 0.02
  metalColor: {r: 0.78, g: 0.78, b: 0.8, a: 1}
  metallic: 0.9
  smoothness: 0.65
  margin: 0.03
  gap: 0.012
  textRegionStart: 0
  textRegionWidth: 0.75
  titleText: "T\xE0u \u0111i\u1EC7n li\xEAn t\u1EC9nh Trainy McTrainface "
  titleFont: {fileID: 0}
  titleSizeCm: 4
  titleColor: {r: 0.85, g: 0.2, b: 0.25, a: 1}
  titleStyle: 1
  titleAlignment: 257
  subtitleText: (Stadler FLIRT X74)
  subtitleFont: {fileID: 0}
  subtitleSizeCm: 2.2
  subtitleColor: {r: 0.4, g: 0.4, b: 0.4, a: 1}
  subtitleStyle: 2
  subtitleAlignment: 257
  bodyText: "Lo\u1EA1i ph\u01B0\u01A1ng ti\u1EC7n: \u0110o\xE0n t\xE0u \u0111\u1ED9ng
    l\u1EF1c ph\xE2n t\xE1n ch\u1EA1y \u0111i\u1EC7n li\xEAn t\u1EC9nh (Intercity
    EMU)\r\nNh\xE0 s\u1EA3n xu\u1EA5t: Stadler Rail (Th\u1EE5y S\u0129)\r\nM\u1EABu
    t\xE0u \u0111\u1ECBnh danh: Stadler FLIRT Nordic (MTRX Class X74, s\u1ED1 hi\u1EC7u
    74003)\r\nTuy\u1EBFn khai th\xE1c: H\xE0nh lang li\xEAn t\u1EC9nh Stockholm \u0111\u1EBFn
    Gothenburg (Th\u1EE5y \u0110i\u1EC3n)\r\nC\u1EA5u h\xECnh \u0111o\xE0n t\xE0u:
    5 toa kh\u1EDBp n\u1ED1i li\u1EC1n m\u1EA1ch (bogie chia s\u1EBB gi\u1EEFa c\xE1c
    toa)\r\nChi\u1EC1u d\xE0i to\xE0n \u0111o\xE0n: 105.5 m\r\nChi\u1EC1u r\u1ED9ng
    th\xE2n v\u1ECF: 3.2 m (thi\u1EBFt k\u1EBF th\xE2n r\u1ED9ng chu\u1EA9n B\u1EAFc
    \xC2u)\r\nChi\u1EC1u cao th\xE2n xe: 4.15 m\r\nKh\u1ED5 \u0111\u01B0\u1EDDng
    ray: 1435 mm (Kh\u1ED5 ti\xEAu chu\u1EA9n qu\u1ED1c t\u1EBF)\r\nV\u1EADn t\u1ED1c
    khai th\xE1c th\u01B0\u01A1ng m\u1EA1i: 200 km/h\r\nNgu\u1ED3n \u0111i\u1EC7n
    c\u1EA5p: 15 kV AC t\u1EA7n s\u1ED1 16.7 Hz qua l\u01B0\u1EDBi \u0111i\u1EC7n
    tr\xEAn cao\r\nS\u1EE9c ch\u1EE9a thi\u1EBFt k\u1EBF: 244 h\xE0nh kh\xE1ch (to\xE0n
    b\u1ED9 gh\u1EBF ng\u1ED3i \u0111\u1EC7m \xEAm \u0111\u01B0\u1EDDng d\xE0i)\r\nTrang
    b\u1ECB k\u1EF9 thu\u1EADt: V\u1ECF th\xE2n nh\xF4m t\u1ED1i \u01B0u tr\u1ECDng
    l\u01B0\u1EE3ng, c\xF4ng ngh\u1EC7 v\u1EADn h\xE0nh ch\u1ED1ng ch\u1ECBu th\u1EDDi
    ti\u1EBFt b\u0103ng gi\xE1 \xE2m 40 \u0111\u1ED9 C, v\xE1ch c\xE1ch nhi\u1EC7t
    \u0111a l\u1EDBp v\xE0 phanh t\xE1i sinh n\u0103ng l\u01B0\u1EE3ng"
  bodyFont: {fileID: 0}
  bodySizeCm: 1.8
  bodyColor: {r: 0.15, g: 0.15, b: 0.15, a: 1}
  bodyStyle: 0
  bodyAlignment: 264
  lineSpacing: 0
  paragraphSpacing: 0
  columns: 2
  columnGap: 0.02
